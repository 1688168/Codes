class Solution:
    def preorderTraversal(self, root: Optional[TreeNode]) -> List[int]:
        if root is None:
            return []

        result = []
        stack = [root] #python stack is implemented by list

        while stack:
            node = stack.pop()
            result.append(node.val) # pre-order, always process current node

            # Push right first so left is popped first.
            if node.right:
                stack.append(node.right)
            if node.left:
                stack.append(node.left)

        return result